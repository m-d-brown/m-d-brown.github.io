---
import { getCollection } from 'astro:content';
import Default from '../layouts/Default.astro';

// A file in src/pages/ becomes a route from its name: index.astro -> /.
// getCollection returns the validated entries in no guaranteed order, so sort
// explicitly — newest first.
const writeups = await getCollection('writeups');
writeups.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// `name` here is one of the inputs Google uses for the site name shown in
// search results, alongside og:site_name.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  // Each writeup's `isPartOf` points at this @id, which is what joins the
  // article nodes and this one into a single site entity. Must stay identical
  // to the `home` URL built in [slug].astro.
  '@id': new URL('/', Astro.site).toString(),
  name: 'mdbrown.dev',
  url: new URL('/', Astro.site).toString(),
  author: {
    '@type': 'Person',
    name: 'Matt Brown',
    url: new URL('/about', Astro.site).toString(),
  },
};
---

<Default
  seoTitle="mdbrown.dev — homelab, networking, and repair writeups"
  description="Writeups by Matt Brown on home automation, networking, and repair."
  schema={schema}
>
  <h1>Writeups</h1>
  <p>
    With the hope that they might help others, solutions
    to problems I've faced:
  </p>
  {/* The description under each link is the same string the post uses for its
      meta description. Repeating it here costs nothing to maintain, tells a
      reader which writeup they want without a round trip, and turns this page
      from a bare list of titles into one that actually says what the site
      covers. */}
  <ul class="post-list">
    {
      writeups.map((w) => {
        // ISO 8601, which is also the format the datetime attribute wants, so
        // the displayed text and the machine-readable value are one string.
        const iso = w.data.date.toISOString().slice(0, 10);
        return (
          <li>
            {/* Date trails the title inline rather than sitting in its own
                column. A column has to be as wide as the longest date on
                every row, which spent horizontal space on every entry and
                left titles starting well right of the margin. */}
            <a href={`/${w.id}`}>{w.data.title}</a>{' '}
            <span class="post-meta">— <time datetime={iso}>{iso}</time></span>
            <p class="post-summary">{w.data.description}</p>
          </li>
        );
      })
    }
  </ul>
</Default>
