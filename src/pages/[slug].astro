---
import { getCollection, render } from 'astro:content';
import { getImage } from 'astro:assets';
import Default from '../layouts/Default.astro';

export async function getStaticPaths() {
  const writeups = await getCollection('writeups');
  return writeups.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const fmt = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
const isoDate = entry.data.date.toISOString().slice(0, 10);

// Run the lead image through the same pipeline as in-body images so og:image
// points at a built asset rather than the unprocessed source.
const lead = entry.data.image
  ? await getImage({ src: entry.data.image, format: 'jpeg', width: 1200 })
  : undefined;

const canonical = new URL(`/${entry.id}`, Astro.site).toString();
const schema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: isoDate,
  author: {
    '@type': 'Person',
    name: 'Matt Brown',
    url: new URL('/about', Astro.site).toString(),
  },
  publisher: {
    '@type': 'Person',
    name: 'Matt Brown',
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  url: canonical,
  ...(lead && { image: new URL(lead.src, Astro.site).toString() }),
};
---

<Default
  title={entry.data.title}
  seoTitle={entry.data.seoTitle}
  description={entry.data.description}
  publishedTime={entry.data.date}
  imagePath={lead?.src}
  schema={schema}
>
  <h1>{entry.data.title}</h1>
  <p class="post-date">
    <time datetime={isoDate}>{fmt.format(entry.data.date)}</time>
  </p>
  <Content />
</Default>
