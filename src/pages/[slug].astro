---
// Everything between the `---` fences is the component script. It runs once at
// BUILD time on the server and never ships to the browser, so it can read the
// filesystem, await things, and hold data the markup below interpolates.
//
// The square brackets in the filename make this a dynamic route: one source
// file that emits many pages, one per entry returned by getStaticPaths().
import { getCollection, render } from 'astro:content';
import { getImage } from 'astro:assets';
import Default from '../layouts/Default.astro';

// Required for dynamic routes in a static build: Astro calls this to learn
// which pages to generate. Each returned object becomes one page.
//   `params.slug` fills the [slug] in this file's name -> the output URL.
//   `props`       is handed to the page below as Astro.props, so the entry
//                 doesn't have to be looked up a second time.
export async function getStaticPaths() {
  // Reads every markdown file in the collection, already validated against the
  // schema in src/content.config.ts. `entry.id` is the filename-derived slug
  // ("time_machine_uchg_smb"); `entry.data` is the typed frontmatter.
  const writeups = await getCollection('writeups');
  // Newest first, matching the home page's order, so "newer/older" below means
  // the same thing in both places.
  writeups.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
  return writeups.map((entry, i) => ({
    params: { slug: entry.id },
    // Neighbours are resolved here rather than in the page body because
    // getCollection() would otherwise have to run again for every page just to
    // rediscover an ordering this function already computed.
    // Both are undefined at the ends of the list (writeups[-1] and
    // writeups[length]), which the markup below already handles.
    props: { entry, newer: writeups[i - 1], older: writeups[i + 1] },
  }));
}

const { entry, newer, older } = Astro.props;
// render() compiles the markdown body into `Content`, an Astro component that
// gets rendered as <Content /> in the markup below.
const { Content } = await render(entry);

const fmt = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
const isoDate = entry.data.date.toISOString().slice(0, 10);
const isoUpdated = entry.data.updated?.toISOString().slice(0, 10);

// getImage() is the programmatic form of the <Image /> component: same
// optimization, but it returns an object (`lead.src` is the built file's path)
// instead of an <img> tag. Meta tags need the URL string, not an element.
// Running it here also means og:image points at a processed asset rather than
// the original upload.
const lead = entry.data.image
  ? await getImage({ src: entry.data.image, format: 'jpeg', width: 1200 })
  : undefined;

const canonical = new URL(`/${entry.id}`, Astro.site).toString();
const home = new URL('/', Astro.site).toString();

// `@graph` holds several independent objects under one @context, which is how
// you attach more than one type to a page without emitting a second script
// tag. Everything Default.astro receives as `schema` is serialized verbatim.
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'TechArticle',
      headline: entry.data.title,
      description: entry.data.description,
      datePublished: isoDate,
      ...(isoUpdated && { dateModified: isoUpdated }),
      author: {
        '@type': 'Person',
        name: 'Matt Brown',
        url: new URL('/about', Astro.site).toString(),
      },
      publisher: {
        '@type': 'Person',
        name: 'Matt Brown',
      },
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
      url: canonical,
      // Ties the article back to the WebSite entity declared on the home page,
      // so the two aren't read as unrelated things that happen to share a host.
      isPartOf: { '@type': 'WebSite', '@id': home, name: 'mdbrown.dev' },
      ...(lead && { image: new URL(lead.src, Astro.site).toString() }),
    },
    // Tells Google the page sits under the index rather than floating loose,
    // and is what lets a result render "mdbrown.dev › Writeups" instead of a
    // bare URL.
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Writeups', item: home },
        { '@type': 'ListItem', position: 2, name: entry.data.title },
      ],
    },
  ],
};
---

<Default
  title={entry.data.title}
  seoTitle={entry.data.seoTitle}
  description={entry.data.description}
  publishedTime={entry.data.date}
  imagePath={lead?.src}
  schema={schema}
>
  <h1>{entry.data.title}</h1>
  <p class="post-date">
    <time datetime={isoDate}>{fmt.format(entry.data.date)}</time>
    {/* `cond && <jsx/>` renders nothing when cond is falsy; <>...</> is a
        fragment, grouping siblings without adding a wrapper element. */}
    {
      entry.data.updated && (
        <>
          {' · updated '}
          <time datetime={isoUpdated}>{fmt.format(entry.data.updated)}</time>
        </>
      )
    }
  </p>
  <Content />

  {/* Every writeup was previously a dead end: nothing linked out of it except
      the site title and the footer. These give each post inbound links from
      its neighbours, so no page depends on the index alone to be reached, and
      the anchor text describes what's on the other end. */}
  <nav class="post-nav" aria-label="More writeups">
    {
      newer && (
        <p>
          <span>Newer</span>
          <a href={`/${newer.id}`}>{newer.data.title}</a>
        </p>
      )
    }
    {
      older && (
        <p>
          <span>Older</span>
          <a href={`/${older.id}`}>{older.data.title}</a>
        </p>
      )
    }
    <p><span>All</span><a href="/">Every writeup on the site</a></p>
  </nav>
</Default>
