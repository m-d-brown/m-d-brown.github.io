---
import '../styles/global.scss';
import '../styles/print.css';

interface Props {
  title?: string;
  /** Short form of `title`, used only for the <title> tag. */
  seoTitle?: string;
  description?: string;
  /** Set on writeups. Its presence switches og:type to "article". */
  publishedTime?: Date;
  /** Absolute path to an already-processed lead image, for og:image. */
  imagePath?: string;
  /** JSON-LD to embed. Serialized as-is into an ld+json script tag. */
  schema?: Record<string, unknown>;
  /** Keep this page out of search indexes. */
  noindex?: boolean;
  /** Set by Astro for markdown pages using `layout:` — see below. */
  frontmatter?: Record<string, any>;
}

// Markdown pages in src/pages/ hand their frontmatter to the layout as a single
// `frontmatter` object rather than as individual props, so fall back to it.
const p = { ...Astro.props.frontmatter, ...Astro.props };
const { title, seoTitle, description, publishedTime, imagePath, schema } = p;
const noindex = p.noindex ?? false;
const siteTitle = 'mdbrown.dev';
const author = 'Matt Brown';

// Append the site name only when the result still fits an untruncated search
// result (~60 chars). Long titles spend that budget on the title itself.
const base = seoTitle ?? title;
const withSuffix = `${base} — ${siteTitle}`;
const pageTitle = !base
  ? siteTitle
  : withSuffix.length <= 60
    ? withSuffix
    : base;

// `build.format: 'file'` makes pathname "/foo.html", but every internal link
// points at "/foo". GitHub Pages serves both, so canonicalize on the
// extensionless form to keep the two spellings from competing.
const path = Astro.url.pathname
  .replace(/index\.html$/, '')
  .replace(/\.html$/, '');
const canonicalURL = new URL(path, Astro.site).toString();
const imageURL = imagePath
  ? new URL(imagePath, Astro.site).toString()
  : undefined;
---

<!DOCTYPE html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <meta name="author" content={author} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonicalURL} />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/assets/fonts/chivo-900-latin.woff2"
      crossorigin
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={siteTitle}
      href={new URL('rss.xml', Astro.site).toString()}
    />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:type" content={publishedTime ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={siteTitle} />
    {description && <meta property="og:description" content={description} />}
    {imageURL && <meta property="og:image" content={imageURL} />}
    {
      publishedTime && (
        <meta
          property="article:published_time"
          content={publishedTime.toISOString()}
        />
      )
    }
    <meta
      name="twitter:card"
      content={imageURL ? 'summary_large_image' : 'summary'}
    />

    {
      schema && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(schema)}
        />
      )
    }
  </head>
  <body>
    <div id="container">
      <div class="inner">
        <header>
          <div class="site-title"><a href="/">{siteTitle}</a></div>
        </header>

        <hr />
        <section id="main_content">
          <slot />
        </section>

        <hr />
        <footer>
          <a href="/about">About</a> ·
          <a href="/rss.xml">RSS</a> ·
          <a href="https://github.com/m-d-brown" class="github-link"
            >github.com/m-d-brown</a
          >
        </footer>
      </div>
    </div>
  </body>
</html>
