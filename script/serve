#!/bin/bash
# Astro local preview server - mdbrown.dev

PORT=${1:-4001}

# Clear any existing process on the chosen port
EXISTING_PID=$(lsof -ti :$PORT)
if [ ! -z "$EXISTING_PID" ]; then
    echo "$EXISTING_PID" | xargs kill -9 2>/dev/null
    echo "Cleared existing process on port $PORT."
fi

echo "Starting Astro dev server at http://127.0.0.1:$PORT/"
exec npm run dev -- --port "$PORT"
